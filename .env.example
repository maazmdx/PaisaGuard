# PaisaGuard FinOps Environment Configuration
# Copy this file to .env and configure as needed: cp .env.example .env

# Runtime Environment (development | staging | production)
PAISAGUARD_ENV=development

# Administrative / FinOps API Token for protected endpoints (/reconcile/sweep, /ai/investigate, /approvals/decision)
# Required for state mutations. For local evaluation or demo, set a secure random string (e.g. openssl rand -hex 16).
# If left empty, all state-changing endpoints fail closed (HTTP 503 / 401).
PAISAGUARD_API_TOKEN=

# Webhook Security
# Mandatory HMAC-SHA256 signature secret for Razorpay webhooks.
RAZORPAY_WEBHOOK_SECRET=

# Set to true ONLY to permit unsigned webhooks in local demo / testing mode.
PAISAGUARD_DEMO_ALLOW_UNSIGNED_WEBHOOKS=false

# AI Exception Investigation Agent Configuration
# AI_PROVIDER: 'mock' (default, offline deterministic provider for tests & CI), 'groq', or 'gemini'
AI_PROVIDER=mock
# Model defaults:
# - For Groq: groq/compound (or groq/compound-mini)
# - For Gemini: gemini-2.5-flash
AI_MODEL=groq/compound
# Required if AI_PROVIDER=groq. If empty, live Groq calls fail closed.
GROQ_API_KEY=
# Required if AI_PROVIDER=gemini. If empty, live Gemini calls fail closed.
AI_API_KEY=

# Database Configuration (defaults to local reconciliation.db in workspace or /app/data in Docker)
PAISAGUARD_DB_PATH=reconciliation.db
